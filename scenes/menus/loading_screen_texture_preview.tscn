[sub_resource type="Shader" id="Shader_preview_background"]
code = "shader_type canvas_item;\n\nvoid fragment() {\n\tvec2 uv = UV;\n\tfloat vignette = smoothstep(0.95, 0.18, distance(uv, vec2(0.5)));\n\tfloat shaft = smoothstep(0.30, 0.0, abs(uv.x - 0.5)) * smoothstep(0.95, 0.28, uv.y);\n\tvec3 dark_stone = vec3(0.004, 0.011, 0.021);\n\tvec3 cold_blue = vec3(0.008, 0.075, 0.14) * shaft;\n\tCOLOR = vec4((dark_stone + cold_blue) * (0.52 + vignette * 0.48), 1.0);\n}\n"

