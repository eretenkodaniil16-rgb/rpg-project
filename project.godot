; Engine configuration file.
; It is best edited using the Godot editor.
config_version=5

[application]

config/name="Хроники странника"
config/version="0.17.0"
run/main_scene="res://scenes/menus/main_menu.tscn"
config/icon="res://assets/branding/exports/app_icon_192_v01.png"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameState="*res://scripts/core/game_state_world_snapshot.gd"
MusicManager="*res://scripts/audio/music_manager.gd"
MusicThreatStateResolver="*res://scripts/audio/music_threat_state_resolver.gd"
MusicCombatStartResolver="*res://scripts/audio/music_combat_start_resolver.gd"
CombatMusicProfileRegistry="*res://scripts/systems/combat_music_profile_registry.gd"
MusicCombatClimaxResolver="*res://scripts/audio/music_combat_climax_resolver.gd"
CombatOutcomeRegistry="*res://scripts/systems/combat_outcome_registry.gd"
MusicAftermathResolver="*res://scripts/audio/music_aftermath_resolver.gd"
CharacterSelectionTouchAssist="*res://scripts/ui/character_selection_touch_assist.gd"
TouchScrollManager="*res://scripts/ui/touch_scroll_manager.gd"
SceneTransitionManager="*res://scripts/systems/scene_transition_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.065, 1)
